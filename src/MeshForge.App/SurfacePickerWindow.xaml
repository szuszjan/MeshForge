<Window x:Class="SurfacePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        Title="{DynamicResource Str_PickerTitle}" Height="600" Width="940"
        MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PageBackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str_PickerInstructions}"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnCancel" Content="{DynamicResource Str_PickerCancel}" Width="100" Margin="0,0,8,0"/>
                <Button x:Name="BtnApply" Content="{DynamicResource Str_PickerApply}" Style="{StaticResource AccentButton}" Width="100"/>
            </StackPanel>

            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}">
                <ListBox x:Name="ListCandidates" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}" Padding="4"/>
            </Border>
        </DockPanel>

        <Border Grid.Column="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True"
                Background="{DynamicResource ViewportBackgroundBrush}">
            <hx:HelixViewport3D x:Name="Viewport" ShowCoordinateSystem="False" ShowViewCube="False"
                                 ZoomExtentsWhenLoaded="True" Background="Transparent">
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <AmbientLight Color="#FF404040"/>
                            <DirectionalLight Color="#FFB0B0B0" Direction="-0.6,-1,-0.4"/>
                            <DirectionalLight Color="#FF505050" Direction="0.6,0.2,0.8"/>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
                <ModelVisual3D x:Name="MeshVisualHost"/>
                <ModelVisual3D x:Name="PatchVisualHost"/>
            </hx:HelixViewport3D>
        </Border>
    </Grid>
</Window>
